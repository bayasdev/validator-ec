{
  "name": "validator-ec",
  "version": "1.3.1",
  "type": "module",
  "author": "Victor Bayas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayasdev/validator-ec.git"
  },
  "bugs": {
    "url": "https://github.com/bayasdev/validator-ec/issues"
  },
  "keywords": [
    "validator",
    "validador",
    "ecuador",
    "cedula",
    "ci",
    "identidad",
    "ruc"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@hegeldev/hegel": "0.5.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
