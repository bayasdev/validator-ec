{
  "name": "validator-ec",
  "version": "2.0.0",
  "description": "Validadores de cédula, RUC y código postal ecuatorianos, según las reglas que publica el SRI.",
  "keywords": [
    "cedula",
    "ci",
    "consumidor final",
    "ecuador",
    "identidad",
    "ruc",
    "sri",
    "validador",
    "validator"
  ],
  "homepage": "https://github.com/bayasdev/validator-ec#readme",
  "bugs": {
    "url": "https://github.com/bayasdev/validator-ec/issues"
  },
  "license": "Apache-2.0",
  "author": "Victor Bayas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayasdev/validator-ec.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check && knip",
    "check-types": "tsc",
    "check-package": "publint && attw --pack . --profile esm-only",
    "fix": "ultracite fix",
    "test": "vitest run",
    "prepublishOnly": "pnpm check && pnpm check-types && pnpm test && pnpm build && pnpm check-package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@hegeldev/hegel": "0.5.3",
    "@oxlint/plugins": "1.91.0",
    "@types/node": "24.19.2",
    "knip": "6.44.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.15.0"
}
